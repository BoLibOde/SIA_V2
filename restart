#!/bin/bash
set -euo pipefail

APP_DIR="$(cd "$(dirname "${BASH_SOURCE[0]}")" && pwd)"

# Make this script executable
chmod +x "$APP_DIR/restart"

# Kill all running device instances gracefully
pkill -f "python -m device.main" || true

# Wait for clean shutdown
sleep 1

# Start the app (visible on desktop, not backgrounded)
cd "$APP_DIR"
exec ./start_ui.sh
